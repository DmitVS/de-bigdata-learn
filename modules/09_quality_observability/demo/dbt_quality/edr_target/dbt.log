{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"77aea251-fb3e-4cd1-b85d-5b0e89bd1619\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n  select\n    elementary_test_results_id,\n    result_row\n  from \"demo_quality\".\"main_elementary\".\"test_result_rows\"\n  where \n        (date_diff('day', cast(detected_at as timestamp)::timestamp, \n    current_timestamp::timestamp\n::timestamp ))\n     < 7\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from \"ordered_test_results__tmp_2026100216235696487120261002162356969200\"\n        where invocations_rank_index = 1\n    )\n  \n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "77aea251-fb3e-4cd1-b85d-5b0e89bd1619", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"77aea251-fb3e-4cd1-b85d-5b0e89bd1619\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n  select\n    elementary_test_results_id,\n    result_row\n  from \"demo_quality\".\"main_elementary\".\"test_result_rows\"\n  where \n        (date_diff('day', cast(detected_at as timestamp)::timestamp, \n    current_timestamp::timestamp\n::timestamp ))\n     < 7\n  \n    and elementary_test_results_id in (\n        select distinct