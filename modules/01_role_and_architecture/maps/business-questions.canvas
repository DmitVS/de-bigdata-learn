			"text": "**Карточка** → витрина с grain"
		},
		{
			"id": "gl",
			"type": "group",
			"x": 0,
			"y": 140,
			"width": 780,
			"height": 460,
			"label": "Метрики и ограничения"
		},
		{
			"id": "gl0",
			"type": "text",
			"x": 20,
			"y": 180,
			"width": 740,
			"height": 120,
			"text": "Доля = Σ числителя / Σ знаменателя\nне среднее долей: 19,75% против 20,19%"
		},
		{
			"id": "gl1",
			"type": "text",
			"x": 20,
			"y": 320,
			"width": 740,
			"height": 120,
			"text": "Нет цен, продажи нормированы → только относительные метрики"
		},
		{
			"id": "gl2",
			"type": "text",
			"x": 20,
			"y": 460,
			"width": 740,
			"height": 120,
			"text": "[Скрытый спрос](../../../glossary/censored-demand.md): пустая полка → продажи < спроса\nкороткое отсутствие продаётся лучше — обратная причинность"
		},
		{
			"id": "gr",
			"type": "group",
			"x": 820,
			"y": 140,
			"width": 780,
			"height": 460,
			"label": "Ловушка: смешанный фактор",
			"color": "1"
		},
		{
			"id": "gr0",
			"type": "text",
			"x": 840,
			"y": 180,
			"width": 740,
			"height": 120,
			"text": "Дождь: наивно +16% к продажам"
		},
		{
			"id": "gr1",
			"type": "text",
			"x": 840,
			"y": 320,
			"width": 740,
			"height": 120,
			"text": "Июнь–июль: больше дождей И выше продажи — сезон"
		},
		{
			"id": "gr2",
			"type": "text",
			"x": 840,
			"y": 460,
			"width": 740,
			"height": 120,
			"text": "Внутри города × месяца: отношение 0,998 → эффекта нет\n[confounder](../../../glossary/confounder.md)"
		}
	],
