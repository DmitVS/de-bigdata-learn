		{
			"id": "s1",
			"type": "text",
			"x": 336,
			"y": -90,
			"width": 296,
			"height": 160,
			"text": "**Data lake**\nфайлы в S3, нет транзакций → болото"
		},
		{
			"id": "s2",
			"type": "text",
			"x": 652,
			"y": -90,
