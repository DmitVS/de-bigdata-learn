		{
			"id": "gr2",
			"type": "text",
			"x": 840,
			"y": 460,
			"width": 740,
			"height": 120,
			"text": "Kappa — один поток + перечитывание журнала\nу нас: батч + узкий поток в те же Iceberg-таблицы (08)"
		}
