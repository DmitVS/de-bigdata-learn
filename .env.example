# Скопируй в .env (make init сделает это сам) и при желании поменяй пароли.
# .env в .gitignore — реальные секреты в git не попадают.

# UID/GID пользователя хоста — чтобы файлы, созданные в контейнере, принадлежали тебе
HOST_UID=1000
HOST_GID=1000

# Postgres (метаданные Lakekeeper + учебная OLTP-база retail_oltp)
POSTGRES_USER=de
POSTGRES_PASSWORD=change-me-postgres

# S3-хранилище Silo (веб-консоль: http://localhost:9001)
S3_ACCESS_KEY=de-admin
S3_SECRET_KEY=change-me-s3-secret

# Iceberg REST-каталог Lakekeeper (UI: http://localhost:8181/ui)
LAKEKEEPER_ENCRYPTION_KEY=change-me-lakekeeper-encryption-key
ICEBERG_WAREHOUSE=lakehouse

# Учебный API маркетинговой системы (модуль 04, слой ingestion)
RETAIL_API_KEY=change-me-retail-api-key

# Озвучка видео-объяснений через ElevenLabs (слой media). Пусто — озвучка Piper (офлайн).
ELEVENLABS_API_KEY=

# Слой serving (модуль 10). ClickHouse: http://localhost:8123/play; Superset: http://localhost:8088
# (вход admin / SUPERSET_ADMIN_PASSWORD). SUPERSET_SECRET_KEY шифрует пароли подключений в
# метаданных: после смены ключа сохранённые подключения перестанут открываться.
CLICKHOUSE_USER=de
CLICKHOUSE_PASSWORD=change-me-clickhouse
SUPERSET_SECRET_KEY=change-me-superset-secret-key-at-least-32-chars
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin

# Слой governance (модуль 11). OpenMetadata: http://localhost:8585 (admin@open-metadata.org / admin).
# OM_FERNET_KEY шифрует пароли подключений в метаданных: 32 байта в base64 (url-safe).
# OM_INGESTION_TOKEN — JWT бота ingestion-bot: заполняет make om-token после первого запуска.
OM_FERNET_KEY=change-me-32-byte-urlsafe-base64-key=
OM_INGESTION_TOKEN=

# Модуль 13 (опционально): Snowflake trial. Пусто — dbt parse работает, build — нет.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
