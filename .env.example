# Скопируй в .env (make init сделает это сам) и при желании поменяй пароли.
# .env в .gitignore — реальные секреты в git не попадают.

# UID/GID пользователя хоста — чтобы файлы, созданные в контейнере, принадлежали тебе
HOST_UID=1000
HOST_GID=1000

# Postgres (метаданные Lakekeeper + учебная OLTP-база retail_oltp)
POSTGRES_USER=de
POSTGRES_PASSWORD=change-me-postgres

# S3-хранилище Silo (веб-консоль: http://localhost:9001)
S3_ACCESS_KEY=de-admin
S3_SECRET_KEY=change-me-s3-secret

# Iceberg REST-каталог Lakekeeper (UI: http://localhost:8181/ui)
LAKEKEEPER_ENCRYPTION_KEY=change-me-lakekeeper-encryption-key
ICEBERG_WAREHOUSE=lakehouse

# Учебный API маркетинговой системы (модуль 04, слой ingestion)
RETAIL_API_KEY=change-me-retail-api-key

# Озвучка видео-объяснений через ElevenLabs (слой media). Пусто — озвучка Piper (офлайн).
ELEVENLABS_API_KEY=
