# Секреты
.env

# Данные (скачиваются скриптами из datasets/, живут в S3/Iceberg)
data/*
!data/.gitkeep
*.parquet
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# dbt / sqlmesh
target/
dbt_packages/
logs/
.user.yml

# IDE / OS
.idea/
.DS_Store

# Obsidian: в git — общие настройки хранилища и настройки плагинов (data.json),
# без личного состояния окон и без кода плагинов (ставится через make obsidian)
.obsidian/workspace*.json
.obsidian/plugins/*/*
!.obsidian/plugins/*/data.json
.trash/
