#!/bin/sh
# Git-хук pre-commit (модуль 12): проверки идут в контейнере workspace, на хосте нужны только
# docker и make. Ставится командой make hooks (копия в .git/hooks/pre-commit).
# Пропустить один раз: git commit --no-verify (только осознанно).
cd "$(git rev-parse --show-toplevel)" || exit 1
exec make -s precommit ARGS="--hook-stage pre-commit"
